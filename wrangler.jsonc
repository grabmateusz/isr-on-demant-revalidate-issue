/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "isr-on-demant-revalidate-issue",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "isr-on-demant-revalidate-issue-r2"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "isr-on-demant-revalidate-issue"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			},
		],
		"classes": [
			"DOQueueHandler",
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DOQueueHandler",
			]
		}
	],
	"d1_databases": [
        {
            "binding": "NEXT_TAG_CACHE_D1",
            "database_id": "<isr-on-demant-revalidate-issue-database-id>",
            "database_name": "isr-on-demant-revalidate-issue",
        }
    ],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "https://isr-on-demant-revalidate-issue.<zone-name>/*",
			"zone_name": "<zone-name>"
		}
	]
}